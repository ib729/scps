# Render placeholders with tools/ops/setup-host.ts before installing this unit.

[Unit]
Description=SCPS Web Server (Next.js with WebSocket)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__WORKING_DIR__
Environment="NODE_ENV=production"
Environment="HOSTNAME=0.0.0.0"
Environment="NEXT_TELEMETRY_DISABLED=1"
Environment="PATH=__RUN_PATH__"
ExecStart="__NODE_EXEC__" --import tsx server.ts
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
TimeoutStopSec=20s

# Reload environment on restart
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
