# Render __RUN_USER__, __REPO_ROOT__, __NODE_EXEC__ and __RUN_PATH__ with
# tools/ops/setup-debian.ts before installing this unit.

[Unit]
Description=NFC Tap Broadcaster for SCPS POS (WebSocket)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory="__REPO_ROOT__/web-next"
# Load environment variables from file (including NFC_TAP_SECRET)
EnvironmentFile="__REPO_ROOT__/.env.broadcaster"
Environment="NEXTJS_URL=http://localhost:3000"
Environment="POS_LANE_ID=reader-1"
Environment="PN532_DEVICE=tty:USB0:pn532"
Environment="PATH=__RUN_PATH__"

# Pre-start: Reset USB device to ensure clean state (Target USB0 specifically)
ExecStartPre="__NODE_EXEC__" --import tsx tools/ops/reset-usb-nfc.ts USB0

# Main TypeScript process
ExecStart="__NODE_EXEC__" --import tsx hardware/tap-broadcaster.ts

# Post-stop: Allow cleanup time
ExecStopPost=/bin/sleep 1
StandardOutput=journal
StandardError=journal

# Restart policy: Always restart on failure
Restart=always
RestartSec=5

# Kill settings: Give time for cleanup
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target

