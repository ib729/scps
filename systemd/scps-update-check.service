# Render placeholders with tools/ops/setup-host.ts before installing this unit.
[Unit]
Description=Check for an SCPS application update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__WORKING_DIR__
Environment="PATH=__RUN_PATH__"
Environment="SCPS_UPDATE_DIR=/var/lib/scps-update"
Environment="SCPS_UPDATE_BRANCH=main"
UMask=0077
TimeoutStartSec=1min
ExecStart="__NODE_EXEC__" --import tsx tools/ops/release-update.ts check
