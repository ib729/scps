# Render __RUN_USER__, __REPO_ROOT__, __NODE_EXEC__ and __RUN_PATH__ with
# tools/ops/setup-debian.ts before installing this unit.

[Unit]
Description=SCPS Web Server (Next.js with WebSocket)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory="__REPO_ROOT__/web-next"
Environment="NODE_ENV=production"
Environment="HOSTNAME=0.0.0.0"
Environment="NEXT_TELEMETRY_DISABLED=1"
Environment="PATH=__RUN_PATH__"
ExecStart="__NODE_EXEC__" --import tsx server.ts
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5

# Reload environment on restart
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
