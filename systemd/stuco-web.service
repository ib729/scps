# ============================================================================
# INSTALLATION INSTRUCTIONS
# ============================================================================
# Before installing this service file, render these placeholders:
# 1. __RUN_USER__
# 2. __REPO_ROOT__
#
# Example:
#   User=pi
#   WorkingDirectory=/home/pi/stuco/web-next
#   ExecStart=/usr/bin/env pnpm start
# ============================================================================

[Unit]
Description=SCPS Web Server (Next.js with WebSocket)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_ROOT__/web-next
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=0.0.0.0"
ExecStart=/usr/bin/env pnpm start
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5

# Reload environment on restart
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
