#!/bin/bash
# SCPS CLI Launcher

# Exit on errors
set -e

# Detect project root dynamically
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/web-next"

# Run the CLI directly using npx and tsx (bypassing pnpm's strict pre-checks)
npm_config_loglevel=silent npx tsx app/cli/cli.ts "$@"
