{
  "name": "web-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "postinstall": "pnpm rebuild better-sqlite3",
    "auth:migrate": "auth migrate",
    "auth:generate": "auth generate",
    "cli": "node --import tsx app/cli/cli.ts",
    "test": "node --import tsx --test --test-concurrency=1 && node --import tsx app/cli/self-check.ts"
  },
